{
  "name": "@tasklattice/veritas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript guardrail testing workbench powered by the promptfoo SDK",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "veritas": "tsx src/cli.ts",
    "dev": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:integration": "tsx scripts/demo.ts",
    "demo:serve": "tsx scripts/serve-demo.ts",
    "check:publication": "node scripts/check-publication.mjs",
    "check:release": "node --import tsx scripts/check-release.ts",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/chivo-mono": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/source-sans-pro": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.0",
    "echarts": "^6.1.0",
    "fastify": "^5.6.0",
    "github-slugger": "^2.0.0",
    "hyparquet": "^1.0.0",
    "lucide-react": "^1.24.0",
    "lzma-native": "^8.0.6",
    "mdast-util-to-string": "^4.0.0",
    "promptfoo": "0.124.1",
    "radix-ui": "1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.20.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
